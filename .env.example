GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_TIMEOUT_SEC=180
VERIFIER_DEEPSEEK_API_MAX_RETRIES=4
VERIFIER_DEEPSEEK_API_INITIAL_WAIT=5
ISSUE_JUDGE_MODELS=gpt-5.4,claude-sonnet-4.5,grok-4.3,deepseek-v4-pro
ISSUE_JUDGE_MODEL_WEIGHTS=gpt-5.4=0.40,claude-sonnet-4.5=0.35,deepseek-v4-pro=0.18,grok-4.3=0.07
ISSUE_JUDGE_MAX_WORKERS=6
VERIFIER_SLIDE_ERROR_MODEL=gemini-2.5-flash
VERIFIER_CLAIM_EXTRACT_BATCH_SIZE=2
VERIFIER_CLAIM_EXTRACT_MAX_WORKERS=4
VERIFIER_CLAIM_EXTRACT_PROMPT_PROFILE=auto
ISSUE_TYPE_CLASSIFIER_BATCH_SIZE=10
ISSUE_TYPE_CLASSIFIER_MAX_WORKERS=1
ISSUE_TYPE_CLASSIFIER_API_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_BATCH_RETRIES=2
ISSUE_TYPE_CLASSIFIER_BATCH_RETRY_WAIT_SEC=10
ISSUE_TYPE_CLASSIFIER_GROK_RETRY_WAIT_SEC=60
TRANSCRIBE_SILENCE_SPLIT_SEC=1.5
TRANSCRIBE_CHUNK_MAX_SEC=600
TRANSCRIBE_CHUNK_MIN_SEC=30

POSTGRES_DB=graphlec
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
DATABASE_URL=postgresql+asyncpg://user:pass@db/graphlec

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

PYTHONUNBUFFERED=1

# Staged slide extraction.
# 0 means auto: conservative parallelism for scene-level annotation detection.
GRAPHLEC_ANNOT_WORKERS=0

GRAPHLEC_VLM_ENABLED=0
GRAPHLEC_VLM_PROVIDER=ollama
GRAPHLEC_OLLAMA_MODEL=gemma3:4b
GRAPHLEC_OLLAMA_BASE_URL=http://host.docker.internal:11434
GRAPHLEC_VLM_TEMPERATURE=0.0
GRAPHLEC_VLM_APPLY=0
GRAPHLEC_VLM_APPLY_MIN_CONFIDENCE=0.65